# App
MISTHOS_APP_NAME=Misthos
MISTHOS_SIMULATED=true

# Arc. Testnet chain id is 5042002; mainnet is 5042.
MISTHOS_CHAIN=arc-testnet
MISTHOS_CHAIN_ID=5042002
MISTHOS_RPC_URL=https://rpc.testnet.arc.io
MISTHOS_ESCROW_CONTRACT=0x7A3f19bE5c2D80416aB9e0C7d3F5a12B6c8E4d90
# Fixed predeploy on every Arc network. ERC-20 view, 6 decimals.
MISTHOS_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Browser origin allowed to call the API. Vite proxies, so this rarely matters.
MISTHOS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# GitHub App. Not used in the simulation.
MISTHOS_GITHUB_WEBHOOK_SECRET=dev-secret

# Circle. Leave empty to stay offline.
MISTHOS_CIRCLE_API_KEY=

# Persistence. Empty keeps state in memory, reset on every restart. A Postgres URL
# makes it durable (postgresql://user:pass@host/db), and sqlite:///misthos.db does the
# same in a local file. The schema is migrated to the latest version on first use.
MISTHOS_DATABASE_URL=

# The sweeper: claim expiry, deadline refunds and the silent-publisher release. It
# runs inside the API unless a dedicated `mise run dev:worker` process owns it.
MISTHOS_SWEEPER_IN_PROCESS=true
MISTHOS_SWEEP_INTERVAL_SECONDS=60

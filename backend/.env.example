# App
MISTHOS_APP_NAME=Misthos

# Arc. Testnet chain id is 5042002; mainnet is 5042. The network's name, and
# whether its USDC is real, are derived from this id; there is no label to set.
# Any other id is named chain-<id> and its money is reported as unknown, not test.
MISTHOS_CHAIN_ID=5042002
MISTHOS_RPC_URL=https://rpc.testnet.arc.io
MISTHOS_EXPLORER_URL=https://explorer.testnet.arc.io
# MisthosEscrow's address comes from the record `mise run contracts:deploy` writes to
# contracts/deployments/<chain id>.json when it broadcasts. Point elsewhere with the
# file, or pin an address outright (it wins over the record). With neither the API
# refuses to start. It also checks the address holds code before reading it.
MISTHOS_ESCROW_DEPLOYMENT_FILE=
MISTHOS_ESCROW_CONTRACT=
# Fixed predeploy on every Arc network. ERC-20 view, 6 decimals.
MISTHOS_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Browser origin allowed to call the API. Vite proxies, so this rarely matters.
MISTHOS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# GitHub App. Register one from backend/github-app-manifest.json. The App is required:
# issues are read from GitHub and criteria, reviews and statuses are posted as it. The
# key is the App's PEM; escaped newlines (\n) are accepted. Webhooks must be signed
# with the secret, and the dev-secret default is refused.
MISTHOS_GITHUB_WEBHOOK_SECRET=dev-secret
MISTHOS_GITHUB_APP_ID=
MISTHOS_GITHUB_APP_PRIVATE_KEY=
# The App's slug, for the web app's install link, and the label that has an issue
# priced in a repository the publisher installed the App on (#6).
MISTHOS_GITHUB_APP_SLUG=
MISTHOS_GITHUB_LABEL=misthos

# Sign-in. A wallet signs in with a Sign-In with Ethereum message that must name this
# site's domain, taken from the public URL, which is also where GitHub returns after
# an account is linked. The session secret signs session tokens: empty makes a random
# one per process, so sessions end at a restart. Set it to a long random string
# (python -c "import secrets; print(secrets.token_hex(32))") anywhere that matters.
MISTHOS_PUBLIC_URL=http://localhost:5173
MISTHOS_SESSION_SECRET=

# GitHub account linking: an OAuth App, created at https://github.com/settings/developers,
# with the callback {MISTHOS_PUBLIC_URL}/api/v1/auth/github/callback. Locally that is
# homepage http://localhost:5173 and callback
# http://localhost:5173/api/v1/auth/github/callback, which Vite forwards to the API.
# Set both values, here or in the repository's root .env that mise loads, and restart
# the API. Only the login is kept; the access token is used once and dropped. With
# either empty, "Link with GitHub" is not offered.
MISTHOS_GITHUB_OAUTH_CLIENT_ID=
MISTHOS_GITHUB_OAUTH_CLIENT_SECRET=

# The review agent. With a key, a model judges every submitted pull request against its
# acceptance criteria; without one, a rule reviewer judges what the file list proves.
# MISTHOS_ANTHROPIC_API_URL is any Anthropic-compatible /v1/messages endpoint, and the
# key belongs to whoever serves it: DeepSeek's default below takes a DeepSeek key,
# and https://api.anthropic.com takes an Anthropic one. Prices are dollars per million
# tokens, for each verdict's recorded cost; check them and the model id against the
# provider's models page. DeepSeek maps an unknown `claude-*` name onto its own model,
# so the model id below still resolves there. A disputed verdict is reviewed again by
# MISTHOS_REVIEW_DISPUTE_MODEL, or by the same model when it is empty.
MISTHOS_ANTHROPIC_API_KEY=
MISTHOS_ANTHROPIC_API_URL=https://api.deepseek.com/anthropic
MISTHOS_REVIEW_MODEL=claude-sonnet-5-5
MISTHOS_REVIEW_INPUT_USD_PER_MTOK=2.0
MISTHOS_REVIEW_OUTPUT_USD_PER_MTOK=10.0
MISTHOS_REVIEW_DISPUTE_MODEL=

# Circle. Leave empty to stay offline.
MISTHOS_CIRCLE_API_KEY=

# The acceptance attestation key's name in the managed secret store. The key itself
# never goes in an environment file: see docs/runbooks/attestor-rotation.md.
MISTHOS_ATTESTOR_SECRET_REF=
# The escrow owner's key, which records each approved price as the escrow's ceiling.
# Also a reference, never the key.
MISTHOS_OWNER_SECRET_REF=
# The key that signs the paid API's certificates: escrow attestations and settlement
# receipts (docs/PAID-API.md). A third key, unknown to the escrow, so it can move
# nothing. Also a reference, never the key. Unset, those routes answer 503.
MISTHOS_CERTIFICATE_SECRET_REF=
# The paid sanctions screen (#206). Leave it off: reselling a screening provider's
# answers waits for its terms and a legal review.
MISTHOS_PAID_SCREENING_ENABLED=false
# A mounted directory holding the referenced keys, one file each, mode 600. For local
# runs and anvil only; a production deployment supplies its managed store.
MISTHOS_SECRET_STORE_DIR=

# Persistence. Empty keeps state in memory, lost on restart. A Postgres URL makes it
# durable, and sqlite:///misthos.db does the same in a local file. The schema is
# migrated to the latest version on first use.
MISTHOS_DATABASE_URL=

# The sweeper: claim expiry, deadline refunds, the silent-publisher release and the
# reconciliation of the money ledger against the chain. It runs inside the API unless
# a dedicated `mise run dev:worker` process owns it.
MISTHOS_SWEEPER_IN_PROCESS=true
MISTHOS_SWEEP_INTERVAL_SECONDS=60

# Compliance. Identity verification is Stripe Identity; sanctions screening reads the
# official OFAC SDN list. Both are real providers. Without the Stripe key a first
# payout stays pending and is not paid.
MISTHOS_STRIPE_SECRET_KEY=
MISTHOS_STRIPE_API_URL=https://api.stripe.com
MISTHOS_OFAC_SDN_URL=https://sanctionslistservice.ofac.treas.gov/api/PublicationPreview/exports/SDN.XML
MISTHOS_OFAC_REFRESH_SECONDS=86400
MISTHOS_OFAC_CACHE_PATH=

# Logs: one JSON object per line for a log pipeline, plain text for a terminal. A
# separate worker serves Prometheus metrics on the port below; zero serves none.
MISTHOS_LOG_JSON=false
MISTHOS_LOG_LEVEL=INFO
MISTHOS_WORKER_METRICS_PORT=0

# Redis for the per-issue lock, idempotency keys and rate limits (redis://host:6379/0).
# Empty keeps idempotency keys and rate-limit counters in this process, which is only
# correct while one API process runs; the lock then comes from Postgres, if configured.
MISTHOS_REDIS_URL=

# Requests per client per minute. Zero turns a limit off.
MISTHOS_RATE_LIMIT_PUBLISH_PER_MINUTE=30
MISTHOS_RATE_LIMIT_ACTIONS_PER_MINUTE=120

# Edge service, which holds Circle's wallet SDK and sells the paid API. The token must
# match the edge's EDGE_CORE_TOKEN, and is used both ways: without it the edge refuses
# to hand out wallet sessions, and every internal paid route here answers 404
# (docs/PAID-API.md).
MISTHOS_EDGE_URL=http://127.0.0.1:8080
MISTHOS_EDGE_CORE_TOKEN=
# Where buyers reach the edge's paid API from outside, such as https://paid.example.com.
# The web app's API page shows it beside the x402 routes; MISTHOS_EDGE_URL, the address
# inside the network, is never shown.
MISTHOS_PAID_PUBLIC_URL=

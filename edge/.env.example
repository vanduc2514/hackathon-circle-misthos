EDGE_PORT=8080
CORE_API_URL=http://127.0.0.1:8000
# EVM address that receives x402 payments. Required.
MISTHOS_SELLER_ADDRESS=
# Gateway facilitator. The SDK's own default is MAINNET; this defaults to testnet.
GATEWAY_FACILITATOR_URL=https://gateway-api-testnet.circle.com
# CAIP-2 networks to accept, comma separated. Arc testnet by default.
GATEWAY_NETWORKS=eip155:5042002
# Mainnet (https://gateway-api.circle.com or eip155:5042) is refused unless this
# is 5042. Leave it unset.
EDGE_CONFIRM_MAINNET=

# Circle user-controlled wallets, one per publisher and contributor. Required: the
# edge refuses to start without them. The users hold their keys (PIN, 2-of-2 MPC);
# this key can only create users and ask for challenges. App ID: Console > Wallets >
# User Controlled > Configurator.
CIRCLE_API_KEY=
CIRCLE_APP_ID=
# ARC-TESTNET by default. ARC (mainnet) also needs EDGE_CONFIRM_MAINNET=5042.
CIRCLE_WALLET_BLOCKCHAIN=ARC-TESTNET
# Shared with the core (MISTHOS_EDGE_CORE_TOKEN), and used both ways: the core sends
# it to the wallet routes, which refuse every caller without it because they hand out
# Circle user tokens, and the edge sends it to the core's paid routes, which answer
# nothing else. Required once any paid route is listed in src/catalog.ts.
EDGE_CORE_TOKEN=

# The paid API (docs/PAID-API.md). Per-route prices in USDC, overriding the catalog,
# as JSON of route id to price: {"decisions":"0.02"}. An unknown id, or a price that
# is not a positive USDC amount, stops the edge starting.
EDGE_PRICES=
# API keys that call free-tier routes without paying, comma separated, at least 16
# characters each. A signed-in session is free where the core's rule for the route
# says so; these are for callers without one.
EDGE_FREE_API_KEYS=
# The paid sanctions screen. Off: it waits for the provider's terms and a legal review.
EDGE_PAID_SCREENING=

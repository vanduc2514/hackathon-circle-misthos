EDGE_PORT=8080
CORE_API_URL=http://127.0.0.1:8000
# Simulated by default: the 402 handshake is answered locally and any proof is
# accepted. Set to false to settle through Circle Gateway Nanopayments. Read the way
# the API reads it (true/false, 1/0, yes/no, on/off, t/f, y/n); anything else stops
# the service rather than being guessed at, because the API and this gate disagreeing
# about it would give metered endpoints away for free.
MISTHOS_SIMULATED=true
# EVM address that receives x402 payments. Required when not simulated.
MISTHOS_SELLER_ADDRESS=
# Gateway facilitator. The SDK's own default is MAINNET; this defaults to testnet.
GATEWAY_FACILITATOR_URL=https://gateway-api-testnet.circle.com
# CAIP-2 networks to accept, comma separated. Arc testnet by default.
GATEWAY_NETWORKS=eip155:5042002
# Mainnet (https://gateway-api.circle.com or eip155:5042) is refused unless this
# is 5042. Leave it unset.
EDGE_CONFIRM_MAINNET=

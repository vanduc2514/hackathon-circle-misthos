EDGE_PORT=8080
CORE_API_URL=http://127.0.0.1:8000
# Simulated by default: the 402 handshake is answered locally and any proof is
# accepted, and each party gets a made-up wallet address. Set to false to settle
# through Circle Gateway Nanopayments and serve real Circle wallets, which also needs
# CIRCLE_API_KEY, CIRCLE_APP_ID and EDGE_CORE_TOKEN below. Read the way the API reads
# it (true/false, 1/0, yes/no, on/off, t/f, y/n, with no spaces); anything else stops
# the service rather than being guessed at, because the API and the edge disagreeing
# about it would give metered endpoints away and hand the API made-up payout wallets.
MISTHOS_SIMULATED=true
# EVM address that receives x402 payments. Required when not simulated.
MISTHOS_SELLER_ADDRESS=
# Gateway facilitator. The SDK's own default is MAINNET; this defaults to testnet.
GATEWAY_FACILITATOR_URL=https://gateway-api-testnet.circle.com
# CAIP-2 networks to accept, comma separated. Arc testnet by default.
GATEWAY_NETWORKS=eip155:5042002
# Mainnet (https://gateway-api.circle.com or eip155:5042) is refused unless this
# is 5042. Leave it unset.
EDGE_CONFIRM_MAINNET=

# Circle user-controlled wallets, one per publisher and contributor. The users
# hold their keys (PIN, 2-of-2 MPC); this key can only create users and ask for
# challenges. App ID: Console > Wallets > User Controlled > Configurator.
CIRCLE_API_KEY=
CIRCLE_APP_ID=
# ARC-TESTNET by default. ARC (mainnet) also needs EDGE_CONFIRM_MAINNET=5042.
CIRCLE_WALLET_BLOCKCHAIN=ARC-TESTNET
# Shared with the core (MISTHOS_EDGE_CORE_TOKEN). Wallet routes refuse any caller
# without it, because they hand out Circle user tokens.
EDGE_CORE_TOKEN=

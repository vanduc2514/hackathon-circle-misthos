# Arc testnet RPC. Use mainnet (https://rpc.mainnet.arc.io) deliberately.
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io

# Address allowed to attest acceptance and release escrow. The key behind it lives in
# a managed secret store and rotates without a redeploy; see
# docs/runbooks/attestor-rotation.md.
MISTHOS_ATTESTOR_ADDRESS=

# Defaults to the fixed Arc USDC predeploy if unset.
MISTHOS_USDC_ADDRESS=0x3600000000000000000000000000000000000000

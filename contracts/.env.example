# Arc testnet RPC. Use mainnet (https://rpc.mainnet.arc.io) deliberately.
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io

# Required. Where the platform's take rate is paid on every release: a treasury address
# the platform controls. Deploy.s.sol refuses to run without it, because the platform
# sets a rate on every issue and the escrow refuses a release with a rate and no
# recipient. The owner can rotate it later with setFeeRecipient.
MISTHOS_FEE_RECIPIENT_ADDRESS=

# Address allowed to attest acceptance and release escrow. The key behind it lives in
# a managed secret store and rotates without a redeploy; see
# docs/runbooks/attestor-rotation.md.
MISTHOS_ATTESTOR_ADDRESS=

# Defaults to the fixed Arc USDC predeploy if unset.
MISTHOS_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Deploy.s.sol refuses Arc mainnet (5042) unless this names that chain. Leave it
# unset; set it for the one mainnet deploy command and nowhere else.
MISTHOS_CONFIRM_MAINNET=
